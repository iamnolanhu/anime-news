# Public PostHog project token (starts with phc_). Set it in Vercel, never in the repo.
# Analytics never load on localhost or 127.0.0.1.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Shared demo engine (optional). The Studio uses it by default when NEXT_PUBLIC_HOSTED_ENGINE=1; /engine/* is
# proxied server-side to ENGINE_UPSTREAM with ENGINE_TOKEN added. Set all three in Vercel, never in the repo.
NEXT_PUBLIC_HOSTED_ENGINE=
ENGINE_UPSTREAM=
ENGINE_TOKEN=
