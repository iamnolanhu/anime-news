# Public PostHog project token (starts with phc_). Set it in Vercel, never in the repo.
# Analytics never load on localhost or 127.0.0.1.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 measurement id (G-XXXXXXXXXX), set on Vercel only.
# Founder: create a GA4 property with a web data stream for the production site URL, copy its measurement id.
# Loads only on non-local hosts, and only when set.
NEXT_PUBLIC_GA_ID=
